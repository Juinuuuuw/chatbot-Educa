{
  "manifest_version": 3,
  "name": "Educa — assistente local de teste",
  "version": "0.1.2",
  "description": "Atendimento em uma conversa autorizada, com RAG local e resposta por texto ou voz.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*", "http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["heartbeat.js"]}]
}
