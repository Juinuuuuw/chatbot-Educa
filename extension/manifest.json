{
  "manifest_version": 3,
  "name": "Lia — assistente da EdUCA",
  "version": "0.6.2",
  "description": "Painel de atendimento para conversas individuais do WhatsApp, com Lia, RAG local e voz.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*", "http://127.0.0.1:8765/*", "http://127.0.0.1:8766/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://web.whatsapp.com/*"], "js": ["heartbeat.js"]}]
}
